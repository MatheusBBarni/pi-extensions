{
  "name": "pi-extensions",
  "version": "0.1.0",
  "private": true,
  "description": "My day-to-day Pi extensions.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MatheusBBarni/pi-extensions.git"
  },
  "homepage": "https://github.com/MatheusBBarni/pi-extensions",
  "bugs": {
    "url": "https://github.com/MatheusBBarni/pi-extensions/issues"
  },
  "workspaces": [
    "pi-goal-extension",
    "pi-message-queue",
    "pi-run-timer",
    "pi-stitch-mcp"
  ],
  "scripts": {
    "check": "npm run typecheck --workspaces --if-present",
    "pack:dry-run": "npm pack --workspaces --dry-run",
    "publish:goal": "npm publish --workspace @matheusbbarni/pi-goal-extension --access public",
    "publish:queue": "npm publish --workspace @matheusbbarni/pi-message-queue --access public",
    "publish:timer": "npm publish --workspace @matheusbbarni/pi-run-timer --access public",
    "publish:stitch": "npm publish --workspace @matheusbbarni/pi-stitch-mcp --access public",
    "publish:all": "npm run publish:goal && npm run publish:queue && npm run publish:timer && npm run publish:stitch"
  }
}
